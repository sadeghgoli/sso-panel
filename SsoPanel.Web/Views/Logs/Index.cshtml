@model LogsViewModel
@{
    ViewData["Title"] = "گزارش درخواست‌ها";
}
<div class="page-header"><h1>گزارش درخواست‌ها</h1></div>

<div class="card">
    <form method="get" asp-action="Index">
        <div class="form-grid" style="align-items:end">
            <div class="field">
                <label for="clientId">سرویس‌گیرنده</label>
                <select id="clientId" name="clientId">
                    <option value="">همه</option>
                    @foreach (var c in Model.Clients)
                    {
                        <option value="@c.Id" selected="@(Model.ClientId == c.Id)">@c.Name</option>
                    }
                </select>
            </div>
            <div class="field">
                <label class="check" style="margin-bottom:8px">
                    <input type="checkbox" name="onlyRejected" value="true" checked="@Model.OnlyRejected" /> فقط درخواست‌های رد شده
                </label>
            </div>
            <div class="field"><button type="submit" class="btn">فیلتر</button></div>
        </div>
    </form>
</div>

<div class="card">
    <p class="muted" style="margin-bottom:10px">@Model.TotalCount درخواست — صفحه @Model.Page از @Model.TotalPages</p>
    <partial name="_RequestLogTable" model="Model.Items" />
    @if (Model.TotalPages > 1)
    {
        <div class="actions" style="margin-top:14px">
            @if (Model.Page > 1)
            {
                <a class="btn btn-sm btn-outline" asp-action="Index" asp-route-clientId="@Model.ClientId" asp-route-onlyRejected="@Model.OnlyRejected" asp-route-page="@(Model.Page - 1)">قبلی</a>
            }
            @if (Model.Page < Model.TotalPages)
            {
                <a class="btn btn-sm btn-outline" asp-action="Index" asp-route-clientId="@Model.ClientId" asp-route-onlyRejected="@Model.OnlyRejected" asp-route-page="@(Model.Page + 1)">بعدی</a>
            }
        </div>
    }
</div>
