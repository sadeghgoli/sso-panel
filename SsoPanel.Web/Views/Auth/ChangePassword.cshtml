@model ChangePasswordViewModel
@{
    ViewData["Title"] = "تغییر رمز عبور";
}
<div class="page-header"><h1>تغییر رمز عبور</h1></div>
<div class="card" style="max-width:460px">
    <form asp-action="ChangePassword" method="post">
        <div class="field">
            <label asp-for="CurrentPassword">رمز فعلی</label>
            <input asp-for="CurrentPassword" autocomplete="current-password" />
            <span asp-validation-for="CurrentPassword" class="field-error"></span>
        </div>
        <div class="field">
            <label asp-for="NewPassword">رمز جدید</label>
            <input asp-for="NewPassword" autocomplete="new-password" />
            <span asp-validation-for="NewPassword" class="field-error"></span>
        </div>
        <div class="field">
            <label asp-for="ConfirmPassword">تکرار رمز جدید</label>
            <input asp-for="ConfirmPassword" autocomplete="new-password" />
            <span asp-validation-for="ConfirmPassword" class="field-error"></span>
        </div>
        <button type="submit" class="btn">ذخیره</button>
    </form>
</div>
