@model List<Client>
@{
    ViewData["Title"] = "سرویس‌گیرندگان";
}
<div class="page-header">
    <h1>سرویس‌گیرندگان</h1>
    <a class="btn" asp-action="Create">+ سرویس‌گیرنده جدید</a>
</div>
<div class="card">
    @if (Model.Count == 0)
    {
        <p class="muted">هنوز سرویس‌گیرنده‌ای تعریف نشده است.</p>
    }
    else
    {
        <div class="table-wrap">
            <table>
                <thead>
                <tr>
                    <th>نام</th>
                    <th>رابط</th>
                    <th>کلیدهای فعال</th>
                    <th>دامنه‌های فعال</th>
                    <th>وضعیت</th>
                    <th>تاریخ ایجاد</th>
                    <th></th>
                </tr>
                </thead>
                <tbody>
                @foreach (var c in Model)
                {
                    <tr>
                        <td><a asp-action="Details" asp-route-id="@c.Id">@c.Name</a></td>
                        <td>@c.ContactName <span class="muted ltr">@c.ContactPhone</span></td>
                        <td>@c.ApiKeys.Count(k => k.IsUsable)</td>
                        <td>@c.Domains.Count(d => d.IsActive)</td>
                        <td>
                            @if (c.IsActive)
                            {
                                <span class="badge badge-success">فعال</span>
                            }
                            else
                            {
                                <span class="badge badge-muted">غیرفعال</span>
                            }
                        </td>
                        <td><span class="ltr">@c.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd")</span></td>
                        <td class="actions">
                            <a class="btn btn-sm btn-outline" asp-action="Details" asp-route-id="@c.Id">مدیریت</a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>
